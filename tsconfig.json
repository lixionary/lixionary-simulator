{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["lens/src", "game-of-life/src", "cpu/src", "osi/src", "src", "4g-lte/src", "4g-lte/tests", "apparent-annual-motion/src", "error-detection/src", "tests", "vite.config.ts", "playwright.config.ts"]
}
